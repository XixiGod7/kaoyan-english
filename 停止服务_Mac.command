#!/usr/bin/env bash
cd "$(dirname "$0")"

echo "=========================================================="
echo "      考研英语一真题刷题系统 - Mac 停止后台服务"
echo "=========================================================="

PORT=8085
lsof -ti :$PORT | xargs kill -9 2>/dev/null
echo "[成功] 考研英语服务 (端口 $PORT) 已安全关闭！"
sleep 2
